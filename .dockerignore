**/dist
**/target
**/bin
**/obj
**/.venv
**/venv
**/__pycache__
**/.bundle
**/vendor/bundle
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

.git
.github
slides
exercises
tools
**/README.md
**/*.pptx
