<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Payments</RootNamespace>
    <AssemblyName>Payments</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Where the contract lives, relative to this file. The Dockerfile overrides it
         with -p:ProtoDir=/contracts/proto. -->
    <ProtoDir>$(MSBuildProjectDirectory)/../../../contracts/proto</ProtoDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Grpc.AspNetCore, not Grpc.Core.

         .NET serves gRPC on Kestrel over HTTP/2 rather than through a separate server
         library, which is why this is Sdk="Microsoft.NET.Sdk.Web" — a web project that
         happens to speak no HTTP anybody would recognise. Of the six implementations
         this is the only one where the gRPC server and the REST server are the same
         object, and it is worth knowing that is a .NET choice rather than a gRPC one. -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.67.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.67.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- NOTHING EXISTS UNTIL THE CONTRACT DOES.

         GrpcServices="Server" generates the abstract base class PaymentsService
         overrides, and NOT a client. This process implements payments; it does not
         consume it. Compare with services/orders/csharp, which asks for "Client" and
         gets exactly the other half from the same file. -->
    <Protobuf Include="$(ProtoDir)/bootcamp/payments/v1/payments.proto"
              ProtoRoot="$(ProtoDir)"
              GrpcServices="Server" />
  </ItemGroup>

</Project>
